<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- Игровое поле и верхняя панель -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Верхняя панель со счётом и уровнем -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="space_between">

            <TextView
                android:id="@+id/tvLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Уровень: 1"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Счёт: 0"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Сам лабиринт -->
        <com.seed.mazemind.GameView
            android:id="@+id/gameView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Панель управления (стрелки) внизу -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp">

            <Button
                android:id="@+id/btnUp"
                android:layout_width="70dp"
                android:layout_height="50dp"
                android:text="▲" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnLeft"
                    android:layout_width="70dp"
                    android:layout_height="50dp"
                    android:text="◀" />

                <Button
                    android:id="@+id/btnDown"
                    android:layout_width="70dp"
                    android:layout_height="50dp"
                    android:text="▼"
                    android:layout_marginHorizontal="10dp" />

                <Button
                    android:id="@+id/btnRight"
                    android:layout_width="70dp"
                    android:layout_height="50dp"
                    android:text="▶" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Главное меню поверх игры -->
    <LinearLayout
        android:id="@+id/menuLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1E293B"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MazeMind"
            android:textColor="#38BDF8"
            android:textSize="36sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvHighScoreMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Рекорд: 0"
            android:textColor="#94A3B8"
            android:textSize="18sp"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnPlay"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Продолжить"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnNewGame"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Новая игра"
            android:textSize="16sp" />
    </LinearLayout>

</RelativeLayout>
